# Emulador Android (default) o IP LAN para Expo Go (misma Wi‑Fi que exp://192.168.x.x:8081)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000

# En web (tecla w) el cliente usa http://localhost:3000 si la URL de arriba es 10.0.2.2 o IP LAN.
# Solo si necesitás otro back en web: EXPO_PUBLIC_API_URL_WEB=https://tu-api

# Parte III — Firebase (app Web en consola; valores públicos, solo en .env local)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=rachas-50813.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=rachas-50813
EXPO_PUBLIC_FIREBASE_APP_ID=

# Opcional / legacy (no hace falta para email/contraseña ni Google en web con signInWithPopup)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
