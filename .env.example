# Mismo puerto que RachasBack PORT (default 3000)
EXPO_PUBLIC_API_PORT=3000

# Emulador Android (default en código si no hay EXPO_PUBLIC_API_URL):
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Expo Go en iPhone / Android físico (OBLIGATORIO: IP LAN de Metro, no 10.0.2.2):
# Copiá la IP de "Metro: exp://192.168.x.x:8081" y usá EXPO_PUBLIC_API_PORT:
# EXPO_PUBLIC_API_URL=http://192.168.1.71:3000
# EXPO_PUBLIC_WS_URL=http://192.168.1.71:3000

# En web (tecla w) el cliente usa http://localhost:<EXPO_PUBLIC_API_PORT> si la URL de arriba es 10.0.2.2 o IP LAN.
# Solo si necesitás otro back en web: EXPO_PUBLIC_API_URL_WEB=https://tu-api

# WebSockets: opcional; si falta, se usa el mismo origin que EXPO_PUBLIC_API_URL
EXPO_PUBLIC_WS_URL=http://10.0.2.2:3000

# Parte III — Firebase (app Web en consola; valores públicos, solo en .env local)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=rachas-50813.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=rachas-50813
EXPO_PUBLIC_FIREBASE_APP_ID=

# Parte IV — API versionada (default /v2 en código si no se define)
EXPO_PUBLIC_API_PREFIX=/v2

# Congelar app 1.0.0 pre-Parte IV: git checkout app-1.0.0 en RachasFront (sin prefijo /v2)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
