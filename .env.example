# Emulador Android (default del cliente nativo)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Navegador web (tecla w en Expo): http://localhost:3000
# El cliente en web usa localhost:3000 aunque el .env diga 10.0.2.2

# iPhone / Android físico (Expo Go SDK 57, misma Wi‑Fi):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000
