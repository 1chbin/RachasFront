# Emulador Android (default en código si no hay .env):
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Expo Go en iPhone / Android físico (OBLIGATORIO usar IP LAN, no 10.0.2.2):
# Copiá la IP de la línea "Metro: exp://192.168.x.x:8081" y usá puerto 3000:
# EXPO_PUBLIC_API_URL=http://192.168.3.192:3000
# EXPO_PUBLIC_WS_URL=http://192.168.3.192:3000

# En web (tecla w) el cliente usa http://localhost:3000 si la URL de arriba es 10.0.2.2 o IP LAN.
# Solo si necesitás otro back en web: EXPO_PUBLIC_API_URL_WEB=https://tu-api

# Parte III — WebSockets (misma base que la API en celular físico)
EXPO_PUBLIC_WS_URL=http://10.0.2.2:3000

# Parte III — Firebase (app Web en consola; valores públicos, solo en .env local)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=rachas-50813.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=rachas-50813
EXPO_PUBLIC_FIREBASE_APP_ID=

# Opcional / legacy (no hace falta para email/contraseña ni Google en web con signInWithPopup)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
